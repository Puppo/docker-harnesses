# syntax=docker/dockerfile:1

# Each tool is installed in its own stage under its own npm prefix, then copied
# into the final image as a separate layer. With a build cache, a tool whose
# version did not change produces an identical layer, so clients only download
# and extract the tools that actually changed.
#
# Versions default to "latest" for local builds; CI pins them via --build-arg
# so the cache key is stable between nightly runs.

FROM node:lts-slim AS paseo
ARG PASEO_VERSION=latest
RUN npm i -g --no-fund --no-audit --prefix /opt/paseo @getpaseo/cli@${PASEO_VERSION} \
 && rm -rf /root/.npm /tmp/*

FROM node:lts-slim AS pi
ARG PI_VERSION=latest
RUN npm i -g --no-fund --no-audit --prefix /opt/pi @earendil-works/pi-coding-agent@${PI_VERSION} \
 && rm -rf /root/.npm /tmp/* \
 # Older pi versions ship esbuild binaries for every platform; keep only ours (no-op if absent).
 && for d in $(find /opt/pi -type d -name @esbuild -prune); do \
      find "$d" -mindepth 1 -maxdepth 1 ! -name "linux-$(node -p process.arch)" -exec rm -rf {} +; \
    done

FROM node:lts-slim AS opencode
ARG OPENCODE_VERSION=latest
RUN npm i -g --no-fund --no-audit --prefix /opt/opencode @opencode/cli@${OPENCODE_VERSION} \
 && rm -rf /root/.npm /tmp/* \
 # The postinstall hardlinks the right binary into bin/, so the per-platform
 # packages are dead weight afterwards.
 && rm -rf /opt/opencode/lib/node_modules/@opencode/cli/node_modules/@opencode

FROM node:lts-slim AS codex
ARG CODEX_VERSION=latest
RUN npm i -g --no-fund --no-audit --prefix /opt/codex @openai/codex@${CODEX_VERSION} \
 && rm -rf /root/.npm /tmp/*

# Antigravity CLI (`agy`) is a native binary, not an npm package. Paseo drives it
# through its built-in "antigravity" provider. Google publishes one release
# manifest per platform (the same one its install.sh reads) that only points at
# the current release, so AGY_VERSION cannot select an older build: it is the
# cache key, and the build fails if the manifest has moved on in the meantime.
FROM node:lts-slim AS antigravity
ARG AGY_VERSION=latest
ARG AGY_MANIFEST_BASE=https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests
ARG TARGETARCH
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl jq \
 && rm -rf /var/lib/apt/lists/*
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64|arm64) ;; \
      *) echo "Antigravity CLI is not published for linux/${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    manifest=$(curl -fsSL "${AGY_MANIFEST_BASE}/linux_${TARGETARCH}.json"); \
    version=$(echo "$manifest" | jq -er .version); \
    url=$(echo "$manifest" | jq -er .url); \
    sha512=$(echo "$manifest" | jq -er .sha512); \
    if [ "$AGY_VERSION" != latest ] && [ "$version" != "$AGY_VERSION" ]; then \
      echo "Expected Antigravity CLI ${AGY_VERSION}, manifest has ${version}" >&2; exit 1; \
    fi; \
    curl -fsSL -o /tmp/agy.tar.gz "$url"; \
    echo "${sha512}  /tmp/agy.tar.gz" | sha512sum -c -; \
    # The archive holds a single binary named `antigravity`; install.sh renames it to `agy`.
    tar -xzf /tmp/agy.tar.gz -C /tmp antigravity; \
    install -D -m 0755 /tmp/antigravity /opt/antigravity/bin/agy; \
    rm -rf /tmp/*

# Most frequently updated tool goes last: a changed layer invalidates every
# layer after it on the client, never the ones before it.
FROM node:lts-slim AS claude
ARG CLAUDE_CODE_VERSION=latest
RUN npm i -g --no-fund --no-audit --prefix /opt/claude @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
 && rm -rf /root/.npm /tmp/*

FROM node:lts-slim

COPY --from=paseo       /opt/paseo       /opt/paseo
COPY --from=pi          /opt/pi          /opt/pi
COPY --from=opencode    /opt/opencode    /opt/opencode
COPY --from=codex       /opt/codex       /opt/codex
COPY --from=antigravity /opt/antigravity /opt/antigravity
COPY --from=claude      /opt/claude      /opt/claude

# The image pins agy; do not let it replace itself at runtime.
ENV AGY_CLI_DISABLE_AUTO_UPDATE=1
ENV PATH="/opt/claude/bin:/opt/antigravity/bin:/opt/codex/bin:/opt/opencode/bin:/opt/pi/bin:/opt/paseo/bin:${PATH}"

COPY --chmod=755 ai-harness/* /usr/local/bin/

ENTRYPOINT ["entrypoint"]
